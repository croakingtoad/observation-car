{
  "name": "obsidian-observation-car",
  "version": "0.1.0",
  "description": "Obsidian plugin: read EPUBs and PDFs alongside notes anchored to locations in the book.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs --production",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian-plugin",
    "obsidian",
    "epub",
    "pdf",
    "reading",
    "notes"
  ],
  "author": "Marty Martin",
  "license": "MIT",
  "dependencies": {
    "epubjs": "^0.3.93",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^22.20.2",
    "builtin-modules": "^5.3.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
